/**
 * Starlight's footer, followed by the manual's licence.
 *
 * The manual is CC BY 4.0 and the code AGPL-3.0-only, and the page is where
 * somebody quoting it is, so the licence is stated on every page rather than
 * only in the repository. Code samples on the page stay under the code's
 * licence, which is why the line names both.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
